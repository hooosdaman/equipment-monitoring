# Server port
PORT=3000

# Application JWT signing secret (generated locally, not committed)
JWT_SECRET=change-me-to-a-long-random-secret

# Local SQLite database path (optional)
DB_PATH=/var/data/smartinventory.db

# Supabase configuration
# IMPORTANT: Provide these via environment variables / secrets manager. NEVER commit real keys.
# Get these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

